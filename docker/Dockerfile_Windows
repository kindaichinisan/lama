# ------------------------------------------------------------
# Base image
# x86_64 Linux container with NVIDIA CUDA + PyTorch
# ------------------------------------------------------------
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxcb1 \
    git \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Python dependencies
# ------------------------------------------------------------
RUN python3 -m pip install --no-cache-dir \
    --index-url https://pypi.org/simple \
    numpy==1.26.4 \
    scipy==1.11.4 \
    pyyaml \
    tqdm \
    easydict \
    joblib \
    matplotlib \
    pandas \
    tabulate \
    packaging \
    webdataset \
    scikit-learn \
    scikit-image \
    opencv-python-headless \
    hydra-core

# ------------------------------------------------------------
# LaMa dependencies
# ------------------------------------------------------------
RUN python3 -m pip install --no-cache-dir \
    --index-url https://pypi.org/simple \
    albumentations==0.5.2 \
    kornia \
    pytorch-lightning

# ------------------------------------------------------------
# Project directory
# ------------------------------------------------------------
WORKDIR /workspace/lama

ENV PYTHONPATH=/workspace/lama

# ------------------------------------------------------------
# Start shell
# ------------------------------------------------------------
CMD ["/bin/bash"]